{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suifleet.local/interfaces/recipe-1.1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "componentName",
    "componentVersion",
    "artifactBlobId",
    "artifactSha256",
    "lifecycle",
    "configuration"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "componentName": {
      "type": "string"
    },
    "componentVersion": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifactBlobId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "artifactSha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install": {
          "type": [
            "string",
            "null"
          ]
        },
        "run": {
          "type": [
            "string",
            "null"
          ]
        },
        "shutdown": {
          "type": [
            "string",
            "null"
          ]
        },
        "readiness": {
          "type": [
            "string",
            "null"
          ]
        },
        "restart": {
          "type": "string",
          "pattern": "^(never|on-failure|always)$"
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false
    },
    "componentDependencies": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]{1,128}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "versionRequirement"
        ],
        "properties": {
          "versionRequirement": {
            "type": "string",
            "pattern": "^(\\*|(>=|<=|>|<|=|\\^|~)?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?( (>=|<=|>|<|=|\\^|~)?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?)*)$"
          },
          "dependencyType": {
            "type": "string",
            "enum": [
              "HARD",
              "SOFT"
            ]
          }
        }
      }
    }
  }
}
