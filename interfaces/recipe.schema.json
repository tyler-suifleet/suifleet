{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suifleet.local/interfaces/recipe-1.3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "componentName",
    "componentVersion",
    "artifactBlobId",
    "artifactSha256",
    "lifecycle",
    "configuration"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3"
      ]
    },
    "componentName": {
      "type": "string"
    },
    "componentVersion": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifactBlobId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "artifactSha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install": {
          "type": [
            "string",
            "null"
          ]
        },
        "run": {
          "type": [
            "string",
            "null"
          ]
        },
        "shutdown": {
          "type": [
            "string",
            "null"
          ]
        },
        "readiness": {
          "type": [
            "string",
            "null"
          ]
        },
        "restart": {
          "type": "string",
          "pattern": "^(never|on-failure|always)$"
        },
        "validate": {
          "type": "string"
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaults": {
          "type": "object",
          "additionalProperties": true
        },
        "merge": {
          "type": "object",
          "additionalProperties": true
        },
        "reset": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 1024,
            "pattern": "^(/([^~/]|~[01])*)*$"
          }
        },
        "confidential": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 1024,
            "pattern": "^(/([^~/]|~[01])*)+$"
          }
        }
      }
    },
    "componentDependencies": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]{1,128}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "versionRequirement"
        ],
        "properties": {
          "versionRequirement": {
            "type": "string",
            "pattern": "^(\\*|(>=|<=|>|<|=|\\^|~)?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?( (>=|<=|>|<|=|\\^|~)?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?)*)$"
          },
          "dependencyType": {
            "type": "string",
            "enum": [
              "HARD",
              "SOFT"
            ]
          }
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "grants": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "operations": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 40
              },
              "publish": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 128
              },
              "subscribe": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 128
              },
              "pubsub_policies": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "operations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "maxItems": 5
                    },
                    "resources": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "maxItems": 64
                    }
                  },
                  "required": [
                    "operations",
                    "resources"
                  ]
                },
                "maxItems": 32
              },
              "streams": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 64
              },
              "shadow_policies": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "operations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "maxItems": 5
                    },
                    "resources": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "maxItems": 64
                    },
                    "sections": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "desired",
                          "reported"
                        ]
                      },
                      "maxItems": 2
                    }
                  },
                  "required": [
                    "operations",
                    "resources"
                  ]
                },
                "maxItems": 32
              }
            },
            "required": []
          }
        },
        "pubsub": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_messages_per_subscription": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "max_bytes_per_subscription": {
              "type": "integer",
              "minimum": 4096,
              "maximum": 1073741824
            },
            "qos0_messages_per_subscription": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "bridge": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "broker": {
                  "type": "string"
                },
                "client_id": {
                  "type": "string"
                },
                "username": {
                  "type": "string"
                },
                "password_file": {
                  "type": "string"
                },
                "keep_alive_seconds": {
                  "type": "integer",
                  "minimum": 5,
                  "maximum": 600
                },
                "mappings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "topic": {
                        "type": "string"
                      },
                      "source": {
                        "type": "string",
                        "enum": [
                          "LocalMqtt",
                          "Pubsub"
                        ]
                      },
                      "target": {
                        "type": "string",
                        "enum": [
                          "LocalMqtt",
                          "Pubsub"
                        ]
                      },
                      "target_topic_prefix": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "topic",
                      "source",
                      "target"
                    ]
                  },
                  "maxItems": 64
                }
              },
              "required": [
                "broker"
              ]
            }
          },
          "required": []
        },
        "streams": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_streams": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "max_total_bytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 68719476736
            },
            "definitions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "max_size": {
                    "type": "integer",
                    "minimum": 1024,
                    "maximum": 1073741824
                  },
                  "strategy_on_full": {
                    "type": "string",
                    "enum": [
                      "RejectNewData",
                      "OverwriteOldestData"
                    ]
                  },
                  "persistence": {
                    "type": "string",
                    "enum": [
                      "File",
                      "Memory"
                    ]
                  },
                  "time_to_live_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 31536000
                  },
                  "discard_exported": {
                    "type": "boolean"
                  },
                  "export": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "url": {
                        "type": "string"
                      },
                      "bearer_token_file": {
                        "type": "string"
                      },
                      "batch_max_messages": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000
                      },
                      "batch_max_bytes": {
                        "type": "integer",
                        "minimum": 1024,
                        "maximum": 16777216
                      },
                      "batch_interval_seconds": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 3600
                      },
                      "max_backoff_seconds": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 3600
                      }
                    },
                    "required": [
                      "url"
                    ]
                  }
                },
                "required": [
                  "name",
                  "max_size",
                  "strategy_on_full"
                ]
              },
              "maxItems": 1024
            }
          },
          "required": []
        }
      },
      "required": [
        "version"
      ]
    }
  }
}
