{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suifleet.local/interfaces/recipe-1.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "componentName",
    "componentVersion",
    "artifactBlobId",
    "artifactSha256",
    "lifecycle",
    "configuration"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "componentName": {
      "type": "string"
    },
    "componentVersion": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifactBlobId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "artifactSha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install": {
          "type": [
            "string",
            "null"
          ]
        },
        "run": {
          "type": [
            "string",
            "null"
          ],
          "const": null
        },
        "shutdown": {
          "type": [
            "string",
            "null"
          ],
          "const": null
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false
    }
  }
}
