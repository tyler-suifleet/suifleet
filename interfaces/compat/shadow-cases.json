 {
  "id": "nested-delta-path-to-root",
  "steps": [
   {
    "op": {
     "op": "update",
     "shadow": "",
     "request": {
      "state": {
       "desired": {
        "lights": {
         "color": {
          "r": 255,
          "g": 255,
          "b": 255
         }
        }
       },
       "reported": {
        "lights": {
         "color": {
          "r": 255,
          "g": 0,
          "b": 255
         }
        }
       }
      }
     }
    },
    "expect": {
     "state": {
      "desired": {
       "lights": {
        "color": {
         "r": 255,
         "g": 255,
         "b": 255
        }
       }
      },
      "reported": {
       "lights": {
        "color": {
         "r": 255,
         "g": 0,
         "b": 255
        }
       }
      },
      "delta": {
       "lights": {
        "color": {
         "g": 255
        }
       }
      }
     },
     "version": 1
    }
   }
  ]
 },
 {
  "id": "arrays-are-values-and-reported-only-keys-ignored",
  "steps": [
   {
    "op": {
     "op": "update",
     "shadow": "",
     "request": {
      "state": {
       "desired": {
        "list": [
         1,
         2
        ]
       },
       "reported": {
        "list": [
         1,
         3
        ],
        "extra": 1
       }
      }
     }
    },
    "expect": {
     "state": {
      "desired": {
       "list": [
        1,
        2
       ]
      },
      "reported": {
       "list": [
        1,
        3
       ],
       "extra": 1
      },
      "delta": {
       "list": [
        1,
        2
       ]
      }
     },
     "version": 1
    }
   },
   {
    "op": {
     "op": "update",
     "shadow": "",
     "request": {
      "state": {
       "reported": {
        "list": [
         1,
         2
        ]
       }
      }
     }
    },
    "expect": {
     "state": {
      "desired": {
       "list": [
        1,
        2
       ]
      },
      "reported": {
       "list": [
        1,
        2
       ],
       "extra": 1
      }
     },
     "version": 2
    }
   }
  ]
 },
