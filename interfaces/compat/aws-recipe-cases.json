       "Uri": "s3://example-bucket/hello/1.0.0/hello.tar",
       "Algorithm": "SHA-256",
       "Digest": "zc3Nzc3Nzc3Nzc3Nzc3Nzc3Nzc3Nzc3Nzc3Nzc3Nzc0="
