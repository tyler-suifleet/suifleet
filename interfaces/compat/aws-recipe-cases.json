[
 {
  "id": "install-only-translates",
  "note": "Generic component with one install script and one bound artifact maps to one native manifest; ComponentPublisher is reported, not silently dropped.",
  "recipe": {
   "RecipeFormatVersion": "2020-01-25",
   "ComponentName": "com.example.Hello",
   "ComponentVersion": "1.0.0",
   "ComponentPublisher": "Example",
   "Manifests": [
    {
     "Lifecycle": {
      "install": "echo installed"
     },
     "Platform": {
      "os": "linux",
      "architecture": "aarch64"
     },
     "Artifacts": [
      {
       "Uri": "s3://example-bucket/hello/1.0.0/hello.tar"
      }
     ]
    }
   ],
   "ComponentDescription": "Hello component"
  },
  "bindings": {
   "s3://example-bucket/hello/1.0.0/hello.tar": {
    "artifactBlobId": "blob_hello",
    "artifactSha256": "abababababababababababababababababababababababababababababababab"
   },
   "s3://example-bucket/hello/1.0.0/hello-arm.tar": {
    "artifactBlobId": "blob_hello_arm",
    "artifactSha256": "cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd"
   }
  },
  "expected": {
   "outcome": "translate",
   "reasons": [],
   "requires": [],
   "manifests": [
    {
     "os": "linux",
     "arch": "aarch64",
     "recipe": {
      "schemaVersion": "1.0",
      "componentName": "com.example.Hello",
      "componentVersion": "1.0.0",
      "artifactBlobId": "blob_hello",
      "artifactSha256": "abababababababababababababababababababababababababababababababab",
      "lifecycle": {
       "install": "echo installed"
      },
      "configuration": {},
      "description": "Hello component"
     }
    }
   ],
   "omitted_manifests": [],
   "informational": [
    "ComponentPublisher"
   ]
  }
 },
 {
  "id": "multi-platform-dependencies",
  "note": "First-match manifest order is preserved; Windows is omitted and reported; AWS amd64 maps to native x86_64; a manifest without Platform matches all platforms; npm-style comparator ranges inside the native grammar translate to recipe 1.1.",
  "recipe": {
   "RecipeFormatVersion": "2020-01-25",
   "ComponentName": "com.example.Hello",
   "ComponentVersion": "1.0.0",
   "ComponentPublisher": "Example",
   "Manifests": [
    {
     "Platform": {
      "os": "windows"
     },
     "Lifecycle": {
      "install": "echo windows"
     },
     "Artifacts": [
      {
       "Uri": "s3://example-bucket/hello/1.0.0/hello.tar"
      }
     ]
    },
    {
     "Lifecycle": {
      "install": {
       "Script": "echo amd64"
      }
     },
     "Platform": {
      "os": "linux",
      "architecture": "amd64"
     },
     "Artifacts": [
      {
       "Uri": "s3://example-bucket/hello/1.0.0/hello.tar"
      }
     ]
    },
    {
     "Name": "arm32",
     "Platform": {
      "os": "linux",
      "architecture": "arm"
     },
     "Lifecycle": {
      "install": "echo arm"
     },
     "Artifacts": [
      {
       "Uri": "s3://example-bucket/hello/1.0.0/hello-arm.tar"
      }
     ]
    },
    {
     "Lifecycle": {},
     "Artifacts": [
      {
       "Uri": "s3://example-bucket/hello/1.0.0/hello.tar"
      }
     ]
    }
   ],
   "ComponentDependencies": {
    "com.example.Lib": {
     "VersionRequirement": ">=1.0.0 <2.0.0",
     "DependencyType": "SOFT"
    },
    "com.example.Log": {
     "VersionRequirement": "^1.2.0"
    }
   }
  },
  "bindings": {
   "s3://example-bucket/hello/1.0.0/hello.tar": {
    "artifactBlobId": "blob_hello",
    "artifactSha256": "abababababababababababababababababababababababababababababababab"
   },
   "s3://example-bucket/hello/1.0.0/hello-arm.tar": {
    "artifactBlobId": "blob_hello_arm",
    "artifactSha256": "cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd"
   }
  },
  "expected": {
   "outcome": "translate",
   "reasons": [],
   "requires": [],
   "manifests": [
    {
     "os": "linux",
     "arch": "x86_64",
     "recipe": {
      "schemaVersion": "1.1",
      "componentName": "com.example.Hello",
      "componentVersion": "1.0.0",
      "artifactBlobId": "blob_hello",
      "artifactSha256": "abababababababababababababababababababababababababababababababab",
      "lifecycle": {
       "install": "echo amd64"
      },
      "configuration": {},
      "componentDependencies": {
       "com.example.Lib": {
        "versionRequirement": ">=1.0.0 <2.0.0",
        "dependencyType": "SOFT"
       },
       "com.example.Log": {
        "versionRequirement": "^1.2.0"
       }
      }
     }
    },
    {
     "os": "linux",
     "arch": "arm",
     "recipe": {
      "schemaVersion": "1.1",
      "componentName": "com.example.Hello",
      "componentVersion": "1.0.0",
      "artifactBlobId": "blob_hello_arm",
      "artifactSha256": "cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd",
      "lifecycle": {
       "install": "echo arm"
      },
      "configuration": {},
      "componentDependencies": {
       "com.example.Lib": {
        "versionRequirement": ">=1.0.0 <2.0.0",
        "dependencyType": "SOFT"
       },
       "com.example.Log": {
        "versionRequirement": "^1.2.0"
       }
      }
     }
    },
    {
     "os": "*",
     "arch": "*",
     "recipe": {
      "schemaVersion": "1.1",
      "componentName": "com.example.Hello",
      "componentVersion": "1.0.0",
      "artifactBlobId": "blob_hello",
      "artifactSha256": "abababababababababababababababababababababababababababababababab",
      "lifecycle": {},
      "configuration": {},
      "componentDependencies": {
       "com.example.Lib": {
