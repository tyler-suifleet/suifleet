      "width": 1280,
      "height": 760,
      "duration_seconds": 35.12,
      "caption": "Screencast: Fund the network budget.",
      "console_commit": "3586b750c9e722cd7d8c0473c0f41102af46c455",
      "transactions": [
        "8ZSrn1upt8ddq9jH1NZGwYjPE6ubeDX9bqADSwrZmHit"
      ],
      "narration": {
        "voice": "af_heart",
        "language": "en-us",
        "synthetic": true,
        "source_sha256": "e52c3cc35892584d54a5324696df881cb6533fa88f956ab83226db1686975dbb",
        "cues": [
          {
            "text": "The network budget pays operating fees, such as sending device reports. It is separate from your subscription device limit. Choose Network budget in the sidebar.",
            "source_start": 0.0,
            "source_end": 3.708,
            "start": 0,
            "duration": 10.44,
            "speech_start": 0.2,
            "speech_end": 9.927999999999999
          },
          {
            "text": "Enter a deposit in SUI. Devices use these operating funds within your limits. File and log storage has separate funding controls.",
            "source_start": 3.708,
            "source_end": 7.223,
            "start": 10.44,
            "duration": 9.72,
            "speech_start": 10.639999999999999,
            "speech_end": 19.621333333333332
          },
          {
            "text": "Approve the deposit in your wallet. A budget is created only if your fleet needs one.",
            "source_start": 7.223,
            "source_end": 12.835,
            "start": 20.16,
            "duration": 5.88,
            "speech_start": 20.36,
            "speech_end": 25.501333333333335
          },
          {
            "text": "Confirmed. The balance under Keep devices reporting shows the confirmed deposit. Device readiness and health are checked separately.",
            "source_start": 12.835,
            "source_end": 17.2,
            "start": 26.04,
            "duration": 9.08,
            "speech_start": 26.24,
            "speech_end": 34.58133333333333
          }
        ]
      },
      "captions": "fund.en.vtt",
      "captions_sha256": "2dccc1e554859612abb5c3cddb23db7fb6bcd72096bbb3f0cd35a302ead9a1b0",
      "caption_strip_source": {
        "file_sha256": "c7092d462b2c5237fe9a226837ec89f6f242d612c17f48971380ab303d70f468",
        "fallback_sha256": "d5bcae670cf44556ad6d2690da8c53ea66f072f8f7c82ffb7aa5b64374591253",
