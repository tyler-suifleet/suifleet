      "fallback_sha256": "9714cb81da00338573cc720975d1ea65f62749513f995275a28545bb74e6dcb7",
      "poster": "enroll-batch.jpg",
      "poster_sha256": "084bac7ab5ff7f2186c1448f31a8c72664df20a68dc23d7e15213a61158855d3",
      "width": 1280,
      "height": 760,
      "duration_seconds": 55.52,
      "caption": "Screencast: Enroll a batch.",
      "console_commit": "77632f6790f184e38858cdbe67a8a1aebf1a7f2b",
      "transactions": [
        "HQKgzQPM2Yzm3XDM6B5w8MYHck2sndk427AFXkPFUJrL",
        "6ynSYRuqVKmcbVvnWrnve9LfjGKZCfpJfE3yni3gFUjw"
      ],
      "narration": {
        "voice": "af_heart",
        "language": "en-us",
        "synthetic": true,
        "source_sha256": "1135d6e86e5d6f5598073bb09e89ad3b04f44d8d8f68270fc2db3736320f26e5",
        "cues": [
          {
            "text": "Batch enrollment prepares many devices before first boot. Reserve names and serial numbers, then securely give each device its own single-use credential during manufacturing. This avoids registering large fleets one by one. For a production batch, choose Enrollment in the sidebar.",
            "source_start": 0.0,
            "source_end": 6.619,
            "start": 0,
            "duration": 19.04,
            "speech_start": 0.2,
            "speech_end": 18.525333333333332
          },
          {
            "text": "This recording reuses the confirmed batch policy created during setup. On first use, choose the device limit and expiry, then create the policy.",
            "source_start": 6.619,
            "source_end": 6.653,
            "start": 19.04,
            "duration": 10.28,
            "speech_start": 19.24,
            "speech_end": 28.797333333333334
          },
          {
            "text": "2. Reserve names and serial numbers: paste a roster CSV and click Check.",
            "source_start": 6.653,
            "source_end": 11.147,
            "start": 29.32,
            "duration": 5.76,
            "speech_start": 29.52,
            "speech_end": 34.55466666666666
          },
          {
            "text": "Download the credentials: the only copy of the claim keys, for your factory provisioning media.",
            "source_start": 11.147,
            "source_end": 12.417,
            "start": 35.08,
            "duration": 6.48,
            "speech_start": 35.28,
            "speech_end": 41.04
          },
          {
            "text": "Register the reserved devices and approve the request. Each device then enrolls itself at first boot.",
            "source_start": 12.417,
            "source_end": 20.422,
            "start": 41.56,
            "duration": 8.04,
            "speech_start": 41.760000000000005,
            "speech_end": 48.18133333333334
          },
          {
            "text": "Claims are registered and waiting for their devices to enroll with their installed client.",
            "source_start": 20.422,
            "source_end": 25.2,
            "start": 49.6,
            "duration": 5.92,
            "speech_start": 49.800000000000004,
            "speech_end": 54.984
          }
        ]
      },
      "captions": "enroll-batch.en.vtt",
