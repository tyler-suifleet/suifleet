      "width": 1280,
      "height": 760,
      "duration_seconds": 45.56,
      "caption": "Screencast: Enable device capacity.",
      "console_commit": "ad3da5a98f79ec769aad46f7fc6109fcbd6e65ea",
      "transactions": [
        "C9JgGAsYRVKT5bBn7PkKizT12fAv1HCLxUCWyQb137vw",
        "4w3Wa3RY9Bqpd7GxjcrNamZArDDiA9Q7H9bJqKkRA1dS"
      ],
      "narration": {
        "voice": "af_heart",
        "language": "en-us",
        "synthetic": true,
        "source_sha256": "8eaba831f95cd0be9995b824c179c94714b4799167c22030c22333d60967070c",
        "cues": [
          {
            "text": "Check Device capacity before funding devices. A subscription provides places for devices; network deposits pay operating fees.",
            "source_start": 0.0,
            "source_end": 3.814,
            "start": 0,
            "duration": 9.6,
            "speech_start": 0.2,
            "speech_end": 9.074666666666666
          },
          {
            "text": "Choose Plans and billing. Review device capacity and the price shown before approving your selection.",
            "source_start": 3.814,
            "source_end": 10.412,
            "start": 9.6,
            "duration": 6.64,
            "speech_start": 9.799999999999999,
            "speech_end": 15.709333333333333
          },
          {
            "text": "Review the device limit, token amount and verified payment recipient, then approve prepayment. It is separate from device operating funds.",
            "source_start": 10.412,
            "source_end": 17.657,
            "start": 16.24,
            "duration": 9.2,
            "speech_start": 16.439999999999998,
            "speech_end": 24.930666666666664
          },
          {
            "text": "Apply the due prepaid payment to activate capacity. This uses the subscription balance, not another wallet payment; approval still costs a network fee.",
            "source_start": 17.657,
            "source_end": 28.538,
            "start": 25.439999999999998,
            "duration": 10.92,
            "speech_start": 25.639999999999997,
            "speech_end": 35.06933333333333
          },
          {
            "text": "The organization now has capacity for 100 devices. Next, fund device activity; no software has been installed yet.",
            "source_start": 28.538,
            "source_end": 32.72,
            "start": 36.36,
            "duration": 9.2,
            "speech_start": 36.56,
            "speech_end": 45.05066666666667
          }
        ]
      },
      "captions": "capacity-plan.en.vtt",
      "captions_sha256": "ef1675452919319858ff62eeee4d9c781a9306e9b929adae9c9378c6d6bad71a",
      "caption_strip_source": {
