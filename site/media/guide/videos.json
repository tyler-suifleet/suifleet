    {
      "step": "fleet-settings",
      "file": "fleet-settings.webm",
      "file_sha256": "916be169b6afc568b18535a14d4483fd26b4201f3eb48e1c3c9b996f5637f9cb",
      "fallback": "fleet-settings.mp4",
      "fallback_sha256": "96d66679a16d307d8284dba6e8403679cf02fc0036f5b0051fa0b7744c819dbe",
      "poster": "fleet-settings.jpg",
      "poster_sha256": "59cc680b9fd7c4506553bdbc140caed0ade4595577befff28d2660686228e231",
      "width": 1280,
      "height": 760,
      "duration_seconds": 36.88,
      "caption": "Screencast: Choose fleet settings.",
      "console_commit": "88d2364047a358f0a99bb1c1cb4f98744d5cf017",
      "transactions": [
        "8TvnMy38ZXpitThvRZhKFKw4U9rjR37BjeRT97rDLGXu"
      ],
      "narration": {
        "voice": "af_heart",
        "language": "en-us",
        "synthetic": true,
        "source_sha256": "f9c9c80a36545f414a651549f50085ad86af17adda6db118c02a02d0c01fcf22",
        "cues": [
          {
            "text": "Fleet settings choose how often devices check for updates and send reports, and how much data they retain. These choices affect freshness and operating cost. Daily reporting is not live monitoring. Open Fleet settings to choose reporting and update intervals.",
            "source_start": 0.0,
            "source_end": 1.604,
            "start": 0,
            "duration": 17.44,
            "speech_start": 0.2,
            "speech_end": 16.904
          },
          {
            "text": "Review the estimate, then save. Saving settings does not add money to the budget.",
            "source_start": 1.604,
            "source_end": 3.694,
            "start": 17.44,
            "duration": 5.48,
            "speech_start": 17.64,
            "speech_end": 22.418666666666667
          },
          {
            "text": "This small demo budget does not cover the estimate. Save anyway records settings only; it adds no funds.",
            "source_start": 3.694,
            "source_end": 7.978,
            "start": 22.92,
            "duration": 7.44,
            "speech_start": 23.12,
            "speech_end": 29.84
          },
          {
            "text": "Devices apply settings at their next check. Network budget holds their funds separately.",
            "source_start": 7.978,
            "source_end": 14.48,
            "start": 30.360000000000003,
            "duration": 6.52,
            "speech_start": 30.560000000000002,
            "speech_end": 35.76533333333334
          }
        ],
        "synthesis_script_sha256": "76729838f9200130a53f934b0646ff01315b0a3e378e196711dc1add035a741c"
      },
      "captions": "fleet-settings.en.vtt",
      "captions_sha256": "6bdee2ffad0e75d12eccd27a8e6aff6736492132498925930ada2d5a7df7c2b1",
      "caption_strip_source": {
