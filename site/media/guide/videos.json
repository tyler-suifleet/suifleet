    {
      "step": "access-policy",
      "file": "access-policy.webm",
      "file_sha256": "90fa26999eaf993bfb4556a1c5b8d49185eb30a85aea7ce55236aeb147171e43",
      "fallback": "access-policy.mp4",
      "fallback_sha256": "5389b0e62480d7806191850604593bd189711b716cc4ed5391213bd85c6cbdc6",
      "poster": "access-policy.jpg",
      "poster_sha256": "d73108ed058f07451c8eae80b2fd09502cc7e945b88fb3817a72bba36059c486",
      "width": 1280,
      "height": 760,
      "duration_seconds": 30.8,
      "caption": "Screencast: Private-release access.",
      "console_commit": "88d2364047a358f0a99bb1c1cb4f98744d5cf017",
      "transactions": [
        "8BzcWMqxB2Jhmq67BMA1mDXcgQ3zbmfE845gPUoGrTTY",
        "HEviyH2e6wiqj6YCC94ayWcvNb5rfVHwnhfnSkGLexYT"
      ],
      "narration": {
        "voice": "af_heart",
        "language": "en-us",
        "synthetic": true,
        "source_sha256": "4f5a3a3e8acaacec4983fb0a46643a4889f818beec2da179492b303ec099e697",
        "cues": [
          {
            "text": "Access policies are optional controls for confidential software. Choose who can open encrypted files before publishing a private release. They do not give permission to administer the fleet. Open Access policies. A policy controls decryption for confidential releases.",
            "source_start": 0.0,
            "source_end": 8.635,
            "start": 0,
            "duration": 17.72,
            "speech_start": 0.2,
            "speech_end": 17.18133333333333
          },
          {
            "text": "Choose Group and select guide-pilot. Membership determines which devices may request keys.",
            "source_start": 8.635,
            "source_end": 13.936,
            "start": 17.72,
            "duration": 6.24,
            "speech_start": 17.919999999999998,
            "speech_end": 23.44533333333333
          },
          {
            "text": "The grant is recorded. Revocation stops future requests; it cannot recall bytes already decrypted.",
            "source_start": 13.936,
            "source_end": 18.08,
            "start": 23.96,
            "duration": 6.84,
            "speech_start": 24.16,
            "speech_end": 30.261333333333333
          }
        ],
        "synthesis_script_sha256": "76729838f9200130a53f934b0646ff01315b0a3e378e196711dc1add035a741c"
      },
      "captions": "access-policy.en.vtt",
      "captions_sha256": "b9ab575f7c57675cf870c47410c70ac553dad083bab10959ba05409a1312e4b9",
      "caption_strip_source": {
        "file_sha256": "94ecfedbbb5958f96faa46c93d5d1ae53ed4d1d96e43f9d050a873a4ecfe7e65",
        "fallback_sha256": "a5dd83558c5055c42f695cb5c4aeb9ee766edab82e20e988ca7995e78a955210",
