    {
      "step": "register-device",
      "file": "register-device.webm",
      "file_sha256": "4954e5bd72028e77fd3cd9fed0e17638174eaf9a5af2778c1775f9c0397e40a6",
      "fallback": "register-device.mp4",
      "fallback_sha256": "c2d412fb354f2041eb761ced821794d2813a05243a1a2fb7cf5c4536dbf1af26",
      "poster": "register-device.jpg",
      "poster_sha256": "70c73515b5b53df0a103a0365f84fac22ec3b9a224735ebaf448851a641e3fc2",
      "width": 1280,
      "height": 760,
      "duration_seconds": 38.68,
      "caption": "Screencast: Register a device.",
      "console_commit": "3586b750c9e722cd7d8c0473c0f41102af46c455",
      "transactions": [
        "B1m2JfWWhMHKwm2w1FUTiPxQTGiuvZvStWjPoWYjwz8r"
      ],
      "narration": {
        "voice": "af_heart",
        "language": "en-us",
        "synthetic": true,
        "source_sha256": "609f759e66d9fc1d8c474ea7ca70246ac73e173ec5818794e5b4fb287b5aa1bb",
        "cues": [
          {
            "text": "Registration connects a named device to your fleet so updates and reports reach the right machine. For a small pilot, use the public identity generated by the installed device client. Its private key stays on the device. Choose Devices in the sidebar.",
            "source_start": 0.0,
            "source_end": 2.85,
            "start": 0,
            "duration": 17.16,
            "speech_start": 0.2,
            "speech_end": 16.648
          },
          {
            "text": "Click Register by address. Copy the public identity from the device client setup. Never enter its private key.",
            "source_start": 2.85,
            "source_end": 9.248,
            "start": 17.16,
            "duration": 7.52,
            "speech_start": 17.36,
            "speech_end": 24.165333333333333
          },
          {
            "text": "Click Register and approve the transaction.",
            "source_start": 9.248,
            "source_end": 13.515,
            "start": 24.68,
            "duration": 4.28,
            "speech_start": 24.88,
            "speech_end": 27.375999999999998
          },
          {
            "text": "The device is registered. Registration alone does not prove it is online. Its configured client must start and send a verified report.",
            "source_start": 13.515,
            "source_end": 17.68,
            "start": 28.96,
            "duration": 9.72,
            "speech_start": 29.16,
            "speech_end": 38.141333333333336
          }
        ]
      },
      "captions": "register-device.en.vtt",
      "captions_sha256": "1d3a10b7f8ba018e435b1a51d79b658f62e3220dbb26dda00fa13023db6062fe",
      "caption_strip_source": {
