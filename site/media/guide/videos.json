      "narration": {
        "voice": "af_heart",
        "language": "en-us",
        "synthetic": true,
        "source_sha256": "d0a26aaf102af4b274dc881338e41318c01059d27822ec4bbb50c6bdc0776a10",
        "cues": [
          {
            "text": "SuiFleet helps you organize devices and deliver software updates. Your wallet is the approval tool for changes to your account. A fleet is a workspace for devices managed together. Open the console and choose Get started.",
            "source_start": 0.0,
            "source_end": 1.745,
            "start": 0,
            "duration": 14.88,
            "speech_start": 0.2,
            "speech_end": 14.365333333333332
          },
          {
            "text": "Click Connect and choose your wallet: Slush, an extension, or Google where enabled.",
            "source_start": 1.745,
            "source_end": 4.616,
            "start": 14.88,
            "duration": 5.56,
            "speech_start": 15.08,
            "speech_end": 19.901333333333334
          },
          {
            "text": "This recording uses a scripted test wallet in place of Slush; approve the connection.",
            "source_start": 4.616,
            "source_end": 6.003,
            "start": 20.44,
            "duration": 5.64,
            "speech_start": 20.64,
            "speech_end": 25.546666666666667
          },
          {
            "text": "Connected: the account card shows your address and current connection.",
            "source_start": 6.003,
            "source_end": 8.33,
            "start": 26.080000000000002,
            "duration": 4.28,
            "speech_start": 26.28,
            "speech_end": 29.842666666666666
          },
          {
            "text": "First time only: create your default fleet, then approve the transaction.",
            "source_start": 8.33,
            "source_end": 14.143,
            "start": 30.360000000000003,
            "duration": 5.84,
            "speech_start": 30.560000000000002,
            "speech_end": 34.89066666666667
          },
          {
            "text": "Your fleet is selected. Next check device capacity: network funds do not increase your device limit.",
            "source_start": 14.143,
            "source_end": 19.4,
            "start": 36.2,
            "duration": 6.92,
            "speech_start": 36.400000000000006,
            "speech_end": 42.608000000000004
          }
        ]
      },
