    {
      "step": "publish-version",
      "file": "publish-version.webm",
      "file_sha256": "a317bbd6ef3ae25ba8a30f51404a8c51a06efecf9815128a3a0a0150914f23f2",
      "fallback": "publish-version.mp4",
      "fallback_sha256": "e611335eb44d57e5c612065556b744bb05caf912a926c8bc492ae04462f64410",
      "poster": "publish-version.jpg",
      "poster_sha256": "9c53d831f50fc3c21440ed813d2777ad517ebc050e453ab9f819602dc8a77aee",
      "width": 1280,
      "height": 760,
      "duration_seconds": 78.48,
      "caption": "Screencast: Publish a version.",
      "console_commit": "ac6c608b715315d6cd0366244f5641bb52a418ea",
      "transactions": [
        "8DS3iAzqu81qiSqYmxTyduTy4Epap1Kn2cfkfa49bdco",
        "Gv6EqV2ECRkEAqZi1Z2dagpAjhdnat77SXd46uRt3Dax"
      ],
      "narration": {
        "voice": "af_heart",
        "language": "en-us",
        "synthetic": true,
        "source_sha256": "89b72f28562be488a6fe899d861fbef53d3f804c74030ab4ca2aac527dcbf064",
        "cues": [
          {
            "text": "Your software library stores a release once so you can deploy the same version to different devices later. Publishing alone does not install it. Choose Components in the sidebar to publish software.",
            "source_start": 0.0,
            "source_end": 7.434,
            "start": 0,
            "duration": 12.6,
            "speech_start": 0.2,
            "speech_end": 12.082666666666666
          },
          {
            "text": "Name the component and give the release a semantic version.",
            "source_start": 7.434,
            "source_end": 12.098,
            "start": 12.6,
            "duration": 4.68,
            "speech_start": 12.799999999999999,
            "speech_end": 16.21333333333333
          },
          {
            "text": "Choose the platform and attach the artifact for it.",
            "source_start": 12.098,
            "source_end": 15.926,
            "start": 17.28,
            "duration": 3.84,
            "speech_start": 17.48,
            "speech_end": 20.189333333333334
          },
          {
            "text": "Delivery: choose Confidential for proprietary software. This public demo artifact is published unencrypted.",
            "source_start": 15.926,
            "source_end": 19.71,
            "start": 21.12,
            "duration": 7.64,
            "speech_start": 21.32,
            "speech_end": 28.253333333333334
          },
          {
            "text": "Review, then upload to Walrus and register the version. Approve the transaction.",
            "source_start": 19.71,
            "source_end": 64.951,
            "start": 28.76,
            "duration": 45.28,
            "speech_start": 28.96,
            "speech_end": 33.717333333333336
          },
          {
            "text": "Version published. It is now in the library, ready to deploy.",
            "source_start": 64.951,
            "source_end": 69.12,
            "start": 74.04,
            "duration": 4.44,
            "speech_start": 74.24000000000001,
            "speech_end": 77.97333333333334
          }
        ],
        "synthesis_script_sha256": "76729838f9200130a53f934b0646ff01315b0a3e378e196711dc1add035a741c"
      },
      "captions": "publish-version.en.vtt",
      "captions_sha256": "7c1cd8f82318f20740c274b47ffe1714f5f75a75a44f2ce027ec09fabd874b2b",
