    {
      "step": "deploy-group",
      "file": "deploy-group.webm",
      "file_sha256": "b0f13e9f5aadf89397b3c0750a3440263af8ea7e162576b54360b9b1dab46919",
      "fallback": "deploy-group.mp4",
      "fallback_sha256": "97c5a844afef3875a3acc4178d7b8e0e2a7dedcff60ece0045de73594b266f33",
      "poster": "deploy-group.jpg",
      "poster_sha256": "896345a24eefbc647a69fb04e4139fc0557ae4c678f6aa7f23f10387284ba065",
      "width": 1280,
      "height": 740,
      "duration_seconds": 90.96,
      "caption": "Screencast: Deploy to a group.",
      "console_commit": "88d2364047a358f0a99bb1c1cb4f98744d5cf017",
      "transactions": [
        "FkUzW9N7gPcFcB72qxSTGTQ5ZeGbJxkt4b4SPVeNhMqd",
        "EyTwSk2BYYaj5nzsLimoW8Q76XSbeVH2DZot96dcjayM",
        "E7MMAYHoBLsFKJqYLYJcoWEtZK9kvfyMNk5jHWv8sfHw"
      ],
      "narration": {
        "voice": "af_heart",
        "language": "en-us",
        "synthetic": true,
        "source_sha256": "cdfb44f7c54c0b13d70f8970a104673c9802418e36cf2b14cb0c9f612d9fd8c2",
        "cues": [
          {
            "text": "Deployments request a published version for selected devices. Use a group to update related machines together. A request is separate from the device installing it and reporting the outcome. On Devices, open the Device groups tab and create a group.",
            "source_start": 0.0,
            "source_end": 7.36,
            "start": 0,
            "duration": 16.56,
            "speech_start": 0.2,
            "speech_end": 16.050666666666668
          },
          {
            "text": "Click Manage and add the device to the group. Reuse the demo group. First-time operators create a group, then use Manage to add devices.",
            "source_start": 7.36,
            "source_end": 16.022,
            "start": 16.56,
            "duration": 9.32,
            "speech_start": 16.759999999999998,
            "speech_end": 25.378666666666664
          },
          {
            "text": "In the component library, choose Deploy this version.",
            "source_start": 16.022,
            "source_end": 21.28,
            "start": 25.88,
            "duration": 5.28,
            "speech_start": 26.08,
            "speech_end": 29.023999999999997
          },
          {
            "text": "Select the group as the target. This example also selects desired state, which keeps this version requested for group members.",
            "source_start": 21.28,
            "source_end": 25.292,
            "start": 31.16,
            "duration": 8.52,
            "speech_start": 31.36,
            "speech_end": 39.168
          },
          {
            "text": "Click Deploy and approve. Device clients process this request when ready. Creating it alone does not prove installation.",
            "source_start": 25.292,
            "source_end": 44.876,
            "start": 39.68,
            "duration": 19.6,
            "speech_start": 39.88,
            "speech_end": 47.34666666666667
          },
          {
            "text": "Deployment created. Devices report signed results under Deployments.",
            "source_start": 44.876,
            "source_end": 48.806,
            "start": 59.28,
            "duration": 4.96,
            "speech_start": 59.480000000000004,
            "speech_end": 63.70400000000001
          },
          {
            "text": "After the Linux device client processes the update, open Deployments to verify its result. This is a disposable software test, not a physical Raspberry Pi.",
            "source_start": 48.806,
            "source_end": 54.607,
            "start": 64.24,
            "duration": 11.24,
            "speech_start": 64.44,
            "speech_end": 74.95733333333334
          },
          {
            "text": "Applied is a verified device receipt: the client downloaded the software, completed its configured installer and reported success. It does not prove a long-running service is healthy. Deployment created alone did not prove this.",
            "source_start": 54.607,
            "source_end": 58.76,
            "start": 75.47999999999999,
            "duration": 15.48,
            "speech_start": 75.67999999999999,
            "speech_end": 90.44266666666665
          }
        ],
        "synthesis_script_sha256": "c01a3a9a3f929dd3d9c85d8ecf3023c186899dc987e4d7f584002d06bc8041b9"
      },
      "captions": "deploy-group.en.vtt",
      "captions_sha256": "69e36be3b4659a29fcf80b39c5c8e54eecfa527a76561894460f66911a21b283",
      "caption_strip_source": {
        "file_sha256": "20cfc72307fd7e97483b8f3e5f45df015bc1ab0bb85c8f27bc0b4e35f038cc70",
        "fallback_sha256": "757703433bc27cfe119e2442de1f82d54afce99cb6433b782250c790b6e7e2b4",
        "poster_sha256": "d9060d0940ac6f8f5ffdd61e6e503680274f306a545df21c54acf0da4490f752",
        "width": 1280,
        "height": 800,
        "crop_bottom_pixels": 60,
        "transformation_script_sha256": "cbfb6a99eb535be0d12278bb9feac95b3e749b6e3991dce7d7f5887fcf527a2d"
      }
    },
    {
      "step": "staged-rollout",
      "file": "staged-rollout.webm",
      "file_sha256": "ae5ccfbdd61a61b59a9f3483846bb2612c6f4212c87216214a7d21da4906abbe",
      "fallback": "staged-rollout.mp4",
      "fallback_sha256": "21d6f183fdee15f9709bb9af476732fbffb633153c45b17db381c68199548641",
      "poster": "staged-rollout.jpg",
      "poster_sha256": "446b7e282e57e819ba69caabb02259bdb1d1d847906f93bae4a3cf8dcacd25e1",
      "width": 1280,
      "height": 740,
      "duration_seconds": 80.28,
      "caption": "Screencast: Run a staged rollout.",
      "console_commit": "88d2364047a358f0a99bb1c1cb4f98744d5cf017",
      "transactions": [
        "8nrVNaoutpu7fBX8bGaR6nATVSXm1xAQR4rd6CCJDzRn",
        "J9ESmH9jjQvPDYK8wUFf9VF7ktkF9wMn6zxHJvyp14p4"
      ],
      "narration": {
        "voice": "af_heart",
        "language": "en-us",
        "synthetic": true,
        "source_sha256": "860e59f837598de9bbd910a46224bedcbd418b9bcf298e9ba0429dd0ed21292a",
        "cues": [
          {
            "text": "A gradual rollout limits how many devices receive an update at once, so you can check results before continuing. Cohorts are batches. Creation alone starts no devices, and you return to approve further progress. Choose Rollouts in the sidebar to release in stages.",
            "source_start": 0.0,
            "source_end": 3.165,
            "start": 0,
            "duration": 17.88,
            "speech_start": 0.2,
            "speech_end": 17.37333333333333
          },
          {
            "text": "Open Create a gradual rollout. Choose the published version and matching device platform from your library.",
            "source_start": 3.165,
            "source_end": 10.004,
            "start": 17.88,
            "duration": 7.0,
            "speech_start": 18.08,
            "speech_end": 24.37333333333333
          },
          {
            "text": "A cohort is a batch of devices. Add named devices or groups to the first batch; a device belongs to only one batch.",
            "source_start": 10.004,
            "source_end": 11.304,
            "start": 24.88,
            "duration": 8.64,
            "speech_start": 25.08,
            "speech_end": 32.99466666666667
          },
          {
            "text": "Set the pacing, observation period and failure threshold, then review the exact plan. Creating a rollout does not start any device.",
            "source_start": 11.304,
            "source_end": 19.97,
            "start": 33.519999999999996,
            "duration": 9.12,
            "speech_start": 33.72,
            "speech_end": 42.12533333333333
          },
          {
            "text": "Select the rollout, then admit the first devices after checking device health.",
            "source_start": 19.97,
            "source_end": 21.513,
            "start": 42.63999999999999,
            "duration": 5.28,
            "speech_start": 42.839999999999996,
            "speech_end": 47.38399999999999
          },
          {
            "text": "This plan is created with devices waiting, not installed. Only admit devices after reporting is configured and current signed health is available.",
            "source_start": 21.513,
            "source_end": 21.521,
            "start": 47.919999999999995,
            "duration": 10.04,
            "speech_start": 48.12,
            "speech_end": 57.44266666666667
          },
          {
            "text": "Pause stops new devices from starting; it does not undo an update already allowed to start. This example deliberately admits no devices.",
            "source_start": 21.521,
            "source_end": 28.745,
            "start": 57.959999999999994,
            "duration": 9.6,
            "speech_start": 58.16,
            "speech_end": 67.056
          },
          {
            "text": "The saved plan is paused. Return after reporting is ready to resume and explicitly approve the next batch. This clip does not demonstrate a healthy rollout or automatic advancement.",
            "source_start": 28.745,
            "source_end": 32.88,
            "start": 67.55999999999999,
            "duration": 12.72,
            "speech_start": 67.75999999999999,
            "speech_end": 79.74933333333333
          }
        ],
        "synthesis_script_sha256": "c01a3a9a3f929dd3d9c85d8ecf3023c186899dc987e4d7f584002d06bc8041b9"
      },
      "captions": "staged-rollout.en.vtt",
      "captions_sha256": "8113dbce21eb57f3a42e8eff719111e8d0f4a177046e3d8f933b217a6e4f2346",
      "caption_strip_source": {
        "file_sha256": "6668086a80842c652c8eccb435cbd824101d1813ab8e492f63d66c901a1494e1",
        "fallback_sha256": "cd7cf5adb12ec5e8a5c491a4c670930024bca32f95800e68d64d26057f14fde2",
        "poster_sha256": "cfcf366017e4c1e0a42bfd83dce9970fac6a9d51586f8849223ff5cd3f7bc2ae",
