          {
            "text": "Choose Rollouts in the sidebar to release in stages.",
            "source_start": 0,
            "source_end": 3.85,
            "start": 0,
            "duration": 3.88,
            "speech_start": 0.2,
            "speech_end": 3.2293333333333334
          },
          {
            "text": "Open Create a gradual rollout and fill in the version, recipe and digests.",
            "source_start": 3.85,
            "source_end": 13.466,
            "start": 3.88,
            "duration": 9.64,
            "speech_start": 4.08,
            "speech_end": 8.773333333333333
          },
          {
            "text": "List the cohorts, one line each; the first cohort goes first.",
            "source_start": 13.466,
            "source_end": 15.143,
            "start": 13.52,
            "duration": 4.48,
            "speech_start": 13.719999999999999,
            "speech_end": 17.496
          },
          {
            "text": "Set the pacing, bake period and abort threshold, then create the rollout.",
            "source_start": 15.143,
            "source_end": 22.877,
            "start": 18.0,
            "duration": 7.76,
            "speech_start": 18.2,
            "speech_end": 22.57333333333333
          },
          {
            "text": "Select the rollout, then admit the first devices after checking device health.",
            "source_start": 22.877,
            "source_end": 29.852,
