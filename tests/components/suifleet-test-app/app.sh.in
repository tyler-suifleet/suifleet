#!/bin/sh
# suifleet-test-component 1
# component=@COMPONENT@
# version=@VERSION@
# run_id=@RUN_ID@
# fail=@FAIL@
#
# Harmless SuiFleet OTA test application (SF-030). Generated by
# scripts/test_component.py; the header above is what the test updater reads.
# It only touches the directory it is given: no boot partitions, services or
# network. `fail` bakes an injected failure into this exact artifact, so every
# variant has its own authenticated SHA-256.
set -eu

COMPONENT='@COMPONENT@'
VERSION='@VERSION@'
RUN_ID='@RUN_ID@'
FAIL='@FAIL@'

[ $# -eq 2 ] || { echo "usage: $0 install|run|health DIR" >&2; exit 64; }
dir=$2

case $1 in
install)
    if [ "$FAIL" = install ]; then
        echo "$COMPONENT $VERSION: injected install failure" >&2
        exit 1
    fi
    ;;
run)
    # One JSON line proving which artifact actually executed, and where.
    boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)
    printf '{"component":"%s","version":"%s","runId":"%s","arch":"%s","bootId":"%s","executedAt":"%s"}\n' \
        "$COMPONENT" "$VERSION" "$RUN_ID" "$(uname -m)" "$boot_id" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    ;;
health)
    if [ "$FAIL" = health ]; then
        echo "$COMPONENT $VERSION: injected health failure" >&2
        exit 1
    fi
    [ -x "$dir/app" ]
    ;;
*)
    echo "usage: $0 install|run|health DIR" >&2
    exit 64
    ;;
esac
