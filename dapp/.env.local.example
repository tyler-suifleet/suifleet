# Generate a verified network bundle (docs/DEPLOYMENT_MANIFEST.md), copy its
# frontend.env to .env.local, and rebuild the frontend.
# NEXT_PUBLIC_DEPLOYMENT_MANIFEST='<verified deployment manifest JSON>'
# scripts/redeploy.sh writes it to .env.local after each publish or upgrade.
# Walrus storage period for uploads, in epochs (default 5). Devices cannot
# download a recipe or artifact after its storage period ends.
NEXT_PUBLIC_WALRUS_EPOCHS=5
# Optional per-upload storage budget in FROST (1 WAL = 1e9 FROST); exceeding it warns.
# NEXT_PUBLIC_WALRUS_MAX_COST_FROST=
# Optional Google zkLogin (testnet/mainnet only). Both values are public browser
# identifiers. NEVER use an Enoki private API key or an OAuth client secret.
# Provision origin/redirect allowlists first; see docs/WALLET_ONBOARDING.md.
# NEXT_PUBLIC_ENOKI_API_KEY=enoki_public_...
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=....apps.googleusercontent.com
# Confidential delivery (SF-022): Seal key server object IDs and weights, and
# the threshold. Public identifiers only: never put provider API keys here.
# NEXT_PUBLIC_SEAL_KEY_SERVERS='[{"objectId":"0x...","weight":1},{"objectId":"0x...","weight":1}]'
# NEXT_PUBLIC_SEAL_THRESHOLD=2
