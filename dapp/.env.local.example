# Generated by scripts/redeploy.sh after publishing/upgrading contracts.
# Copy to .env.local and fill in your deployed values, or run redeploy.sh.
NEXT_PUBLIC_PACKAGE_ID=0x
NEXT_PUBLIC_ORIGINAL_PACKAGE_ID=0x
NEXT_PUBLIC_REGISTRY_ID=0x
NEXT_PUBLIC_NETWORK=testnet
# Walrus storage period for uploads, in epochs (default 5). Devices cannot
# download a recipe or artifact after its storage period ends.
NEXT_PUBLIC_WALRUS_EPOCHS=5
# Optional per-upload storage budget in FROST (1 WAL = 1e9 FROST); exceeding it warns.
# NEXT_PUBLIC_WALRUS_MAX_COST_FROST=
