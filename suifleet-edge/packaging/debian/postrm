#!/bin/sh
set -eu
if [ "$1" = purge ]; then
    for unit in suifleet.service suifleet-enrollment.path suifleet-signer.socket suifleet-signer.service suifleet-provision.service; do
        if command -v deb-systemd-helper >/dev/null 2>&1; then
            deb-systemd-helper purge "$unit" >/dev/null
        fi
    done
    # Keep accounts, identity, enrollment credentials, operator config and
    # journals even on purge. Destruction requires a separate operator action.
fi
if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload
fi
