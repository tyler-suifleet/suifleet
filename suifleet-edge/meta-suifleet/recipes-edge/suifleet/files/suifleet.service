[Unit]
Description=SuiFleet Edge Deployment Client
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
StateDirectory=suifleet
UMask=0077
ExecStartPre=/usr/bin/suifleet --provision /etc/suifleet/device.key
ExecStart=/usr/bin/suifleet
Restart=on-failure
RestartSec=5
WatchdogSec=60
NotifyAccess=main
EnvironmentFile=-/etc/suifleet/env

[Install]
WantedBy=multi-user.target
