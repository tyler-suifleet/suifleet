[Unit]
Description=Watch for SuiFleet firmware requests

[Path]
# Requests are published atomically by the unprivileged daemon.
PathExistsGlob=/var/lib/suifleet/firmware/requests/*.json
# A claim left by a helper that died mid-update (e.g. power loss) is turned
# into an "interrupted" result on the next run, including at boot.
PathExistsGlob=/var/lib/suifleet/firmware/requests/*.claimed
Unit=suifleet-firmware.service

[Install]
WantedBy=multi-user.target
