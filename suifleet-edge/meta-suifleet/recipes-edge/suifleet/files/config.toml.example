[sui]
rpc_url = "https://fullnode.testnet.sui.io:443"
original_package_id = "0x..." # First published package ID; event type origin
package_id = "0x<PACKAGE_ID>"

[device]
keypair_path = "/etc/suifleet/device.key"
device_object_id = "0x<DEVICE_OBJECT_ID>"
device_cap_id = "0x<DEVICE_CAP_ID>"

[walrus]
aggregator_url = "https://aggregator.walrus-testnet.walrus.space"
# Downloads go to <artifact>.partial and resume with HTTP Range after interruption.
# max_artifact_bytes = 1073741824   # refuse larger artifacts (default 1 GiB)
# min_free_bytes = 67108864         # keep this much free on the state filesystem (default 64 MiB)
# download_attempts = 4             # per blob, for drops, timeouts, 5xx and 429

[apply]
# Command to invoke when an artifact is ready. The artifact path is appended as the final argument.
command = "/usr/bin/swupdate -i"

# Bound the updater execution time. Recipe shell commands require explicit opt-in.
timeout_seconds = 600
allow_recipe_commands = false

# The daemon runs as the unprivileged suifleet user. "direct" runs the command
# above as that user (unprivileged updaters only). "privileged-helper" hands the
# verified artifact to suifleet-firmware.service, which runs the command from
# root-owned /etc/suifleet/firmware.toml instead; recipe scripts never do.
mode = "privileged-helper"
# max_memory_bytes = 268435456   # optional RLIMIT_AS for updater/recipe children

[runtime]
state_dir = "/var/lib/suifleet"
poll_seconds = 10

# First enrollment skips historical events; existing cursors always catch up.
# Enable only if explicitly replaying old one-shot deployments is safe.
replay_history = false

# Dependency candidates: "never" (default) uses only the live catalog and
# Walrus; "cached" keeps authenticated versions/recipes/artifacts under
# state_dir/components for reuse and offline resolution.
# See docs/COMPONENT_DEPENDENCIES.md.
# [components]
# offline_candidates = "never"
# cache_max_bytes = 536870912
