#!/usr/bin/env python3
"""Run the portable daemon and signer as a single foreground service."""

import argparse
import errno
import fcntl
import hashlib
import json
import os
from pathlib import Path
import pwd
import signal
import shutil
import socket
import stat
import subprocess
import tempfile
import time


def trusted_directory(directory):
    for parent in (directory, *directory.parents):
        metadata = parent.lstat()
        if not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid or metadata.st_mode & 0o022:
            raise RuntimeError(f"expected a root-owned directory without group/other writes: {parent}")


def trusted_binary(path):
    trusted_directory(path.parent)
    metadata = path.lstat()
    if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid
            or metadata.st_mode & 0o6022 or not metadata.st_mode & 0o100):
        raise RuntimeError(f"expected a root-owned regular executable: {path}")
    return path


class ClientUpdate:
    """The platform supplies a verified candidate in a root-owned directory."""

    def __init__(self, directory, base):
        self.directory = directory
        self.base = base
        self.path = directory / "state.json"
        self.state = json.loads(self.path.read_text()) if self.path.exists() else {}
        if self.state.get("trial"):
            self.resolve(False)

    def sync(self):
        fd = os.open(self.directory, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)

    def save(self):
        with tempfile.NamedTemporaryFile(mode="w", dir=self.directory, delete=False) as handle:
            tmp = Path(handle.name)
            try:
                json.dump(self.state, handle)
                handle.flush()
                os.fsync(handle.fileno())
                tmp.replace(self.path)
                self.sync()
            finally:
                tmp.unlink(missing_ok=True)

    def select(self):
        digest = self.state.get("trial") or self.state.get("current")
        return trusted_binary(self.directory / digest) if digest else self.base

    def stage(self, request):
        digest = request["sha256"]
        if (not isinstance(digest, str) or len(digest) != 64
                or any(c not in "0123456789abcdef" for c in digest)
                or not isinstance(request["deployment"], str)):
            raise RuntimeError("invalid managed update request")
        self.state["result"] = {"deployment": request["deployment"], "applied": False}
        try:
            source = trusted_binary(self.directory / "candidate")
            with source.open("rb") as incoming, self.base.open("rb") as base:
                header = incoming.read(20)
                baseline = base.read(20)
                if (len(header) != 20 or header[:6] != baseline[:6]
                        or header[18:20] != baseline[18:20] or not header.startswith(b"\x7fELF")):
                    raise RuntimeError("candidate ELF ABI differs from the installed client")
                incoming.seek(0)
                with tempfile.NamedTemporaryFile(dir=self.directory, delete=False) as output:
                    tmp = Path(output.name)
                    try:
                        shutil.copyfileobj(incoming, output)
                        output.flush()
                        with tmp.open("rb") as check:
                            hashed = hashlib.sha256()
                            for chunk in iter(lambda: check.read(65536), b""):
                                hashed.update(chunk)
                        if hashed.hexdigest() != digest:
                            raise RuntimeError("candidate digest differs from the deployment")
                        os.fchmod(output.fileno(), 0o755)
                        os.fsync(output.fileno())
                        tmp.replace(self.directory / digest)
                        self.sync()
                    finally:
                        tmp.unlink(missing_ok=True)
        except (OSError, RuntimeError) as error:
            print(f"suifleet client update refused: {error}", flush=True)
        else:
            self.state["trial"] = digest
        self.save()

    def resolve(self, applied):
        trial = self.state.pop("trial", None)
        if trial:
            if applied:
                self.state["current"] = trial
            self.state["result"]["applied"] = applied
            self.save()
        current = self.state.get("current")
        for path in self.directory.iterdir():
            name = path.name
            if name != current and len(name) == 64 and all(c in "0123456789abcdef" for c in name):
                path.unlink()
        self.sync()


def wait_for_signer(path, signer, daemon):
    deadline = time.monotonic() + 15
    while time.monotonic() < deadline:
        if signer.poll() is not None or daemon.poll() is not None:
            raise RuntimeError("portable signer or gated daemon exited before readiness")
        try:
            with socket.socket(socket.AF_UNIX) as probe:
                probe.settimeout(1)
                probe.connect(str(path))
                probe.sendall(b'{"op":"address"}\n')
                with probe.makefile("rb") as response:
                    if isinstance(json.loads(response.readline(1024)).get("address"), str):
                        return
        except (OSError, ValueError):
            pass
        time.sleep(0.1)
    raise RuntimeError("portable signer readiness timed out")


def stop(children):
    for child in children:
        if child.poll() is None:
            child.terminate()
    deadline = time.monotonic() + 10
    for child in children:
        try:
            child.wait(timeout=max(0, deadline - time.monotonic()))
        except subprocess.TimeoutExpired:
            child.kill()
            child.wait()


def run(args, daemon_user, signer_user, updates=None):
    if args.socket.exists() or args.socket.is_symlink():
        if not stat.S_ISSOCK(args.socket.lstat().st_mode):
            raise RuntimeError(f"refusing to replace non-socket path {args.socket}")
        args.socket.unlink()
    children = []
    control = child_control = None
    try:
        command = [updates.select() if updates else args.binary, "--portable-daemon-child",
                   str(daemon_user.pw_uid), str(daemon_user.pw_gid), args.socket, str(os.getpid())]
        inherited = ()
        if updates:
            control, child_control = socket.socketpair(socket.AF_UNIX, socket.SOCK_SEQPACKET)
            inherited = (child_control.fileno(),)
            command.append(str(child_control.fileno()))
        daemon = subprocess.Popen(
            command,
            pass_fds=inherited,
            stdin=subprocess.PIPE,
            env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "EDGE_CONFIG": str(args.daemon_config)},
        )
        children.append(daemon)
        if child_control:
            child_control.close()
        # The child is alive and root, blocked on the gate. Do not reap it
        # before pinning its task directory and creating a fresh socket.
        task = os.open(f"/proc/{daemon.pid}", os.O_PATH | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            with socket.socket(socket.AF_UNIX) as listener:
                # Linux creates pathname sockets with 0777 filtered by umask.
                # Allow only root and the daemon group to connect. Assign
                # the group before listening and restore the private file mask.
                previous_mask = os.umask(0o117)
                try:
                    listener.bind(str(args.socket))
                finally:
                    os.umask(previous_mask)
                # A directory default ACL can override the bind-time mask.
                # Reject inherited extended access and unexpected mode bits.
                try:
                    os.getxattr(args.socket, "system.posix_acl_access")
                except OSError as error:
                    if error.errno not in (errno.ENODATA, errno.EOPNOTSUPP):
                        raise
                else:
                    raise RuntimeError("portable signer socket must not inherit an access ACL")
                if stat.S_IMODE(args.socket.stat().st_mode) != 0o660:
                    raise RuntimeError("portable signer socket requires mode 0660")
                os.chown(args.socket, 0, daemon_user.pw_gid)
                listener.listen(32)
                signer = subprocess.Popen(
                    [args.binary, "--portable-signer-child", args.signer_config,
                     str(listener.fileno()), str(task), str(daemon_user.pw_uid), str(os.getpid())],
                    pass_fds=(listener.fileno(), task),
                    user=signer_user.pw_uid,
                    group=signer_user.pw_gid,
                    extra_groups=[],
                    stdin=subprocess.DEVNULL,
                    env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin"},
                )
                children.append(signer)
        finally:
            os.close(task)
        wait_for_signer(args.socket, signer, daemon)
        daemon.stdin.write(b"\1")
        daemon.stdin.close()
        if control:
            control.settimeout(60)
            if control.recv(1024) != b"ready" or daemon.poll() is not None or signer.poll() is not None:
                raise RuntimeError("managed daemon exited without completing startup")
            updates.resolve(True)
            control.sendall(json.dumps(updates.state.get("result")).encode())
        while all(child.poll() is None for child in children):
            time.sleep(0.1)
        if control and daemon.returncode == 75 and signer.poll() is None:
            return json.loads(control.recv(1024))
        raise RuntimeError("portable signer or daemon exited; restart the paired service")
    finally:
        if child_control:
            child_control.close()
        if control:
            control.close()
        stop(children)
        args.socket.unlink(missing_ok=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--binary", type=Path, default=Path("/usr/bin/suifleet"))
    parser.add_argument("--socket", type=Path, default=Path("/run/suifleet-portable/signer.sock"))
    parser.add_argument("--daemon-config", type=Path, default=Path("/etc/suifleet/config.toml"))
    parser.add_argument("--signer-config", type=Path, default=Path("/etc/suifleet/signer.toml"))
    parser.add_argument("--client-update-dir", type=Path,
                        help="root-owned directory containing a verified, platform-approved candidate")
    args = parser.parse_args()
    if os.geteuid():
        raise RuntimeError("portable signer launcher requires root")
    os.umask(0o077)
    # Debian SysV matches this name together with the root-owned pidfile,
    # interpreter and UID so stale state does not match ordinary Python jobs.
    Path("/proc/self/comm").write_text("suifleet-pair")
    if not os.path.samefile("/proc/1/ns/pid", "/proc/self/ns/pid"):
        raise RuntimeError("portable signer launcher requires procfs mounted for its own PID namespace")
    daemon = pwd.getpwnam("suifleet")
    signer = pwd.getpwnam("suifleet-signer")
    if not daemon.pw_uid or not signer.pw_uid or daemon.pw_uid == signer.pw_uid:
        raise RuntimeError("daemon and signer require separate non-root accounts")
    if not daemon.pw_gid or not signer.pw_gid or daemon.pw_gid == signer.pw_gid:
        raise RuntimeError("daemon and signer require separate non-root primary groups")
    args.binary = trusted_binary(args.binary.resolve(strict=True))
    if not args.socket.is_absolute() or args.socket.name == "" or ".." in args.socket.parts:
        raise RuntimeError("portable signer socket must use a canonical absolute path")
    trusted_directory(args.socket.parent.parent)
    if not args.socket.parent.exists():
        args.socket.parent.mkdir(mode=0o755)
        args.socket.parent.chmod(0o755)
    trusted_directory(args.socket.parent)
    for signum in (signal.SIGTERM, signal.SIGINT):
        signal.signal(signum, request_stop)
    lock = args.socket.with_suffix(args.socket.suffix + ".lock")
    with lock.open("a") as lease:
        fcntl.flock(lease, fcntl.LOCK_EX | fcntl.LOCK_NB)
        if args.client_update_dir is None:
            run(args, daemon, signer)
            return
        directory = args.client_update_dir
        if not directory.is_absolute() or ".." in directory.parts:
            raise RuntimeError("client update directory must have a canonical absolute path")
        trusted_directory(directory)
        if directory.stat().st_mode & 0o077:
            raise RuntimeError("client update directory must be private to root")
        with (directory / "update.lock").open("a") as update_lease:
            fcntl.flock(update_lease, fcntl.LOCK_EX | fcntl.LOCK_NB)
            updates = ClientUpdate(directory, args.binary)
            while True:
                try:
                    request = run(args, daemon, signer, updates)
                except (RuntimeError, OSError):
                    if not updates.state.get("trial"):
                        raise
                    updates.resolve(False)
                else:
                    updates.stage(request)


def request_stop(_signum, _frame):
    for signum in (signal.SIGTERM, signal.SIGINT):
        signal.signal(signum, signal.SIG_IGN)
    raise SystemExit(0)


if __name__ == "__main__":
    try:
        main()
    except (KeyError, OSError, RuntimeError) as error:
        raise SystemExit(f"suifleet-portable-signer: {error}")
